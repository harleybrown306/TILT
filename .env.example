# Public Supabase project configuration. These values are exposed to browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# The one canonical, HTTPS application origin. Set both to exactly the same origin.
# The NEXT_PUBLIC value is embedded when `npm run build` runs.
TILT_APP_URL=https://app.example.com
NEXT_PUBLIC_TILT_APP_URL=https://app.example.com

# Optional, non-secret release label (7-64 characters: letters, digits, ., _, -).
TILT_RELEASE_ID=release-2026-10-06

# Required server-side for guardian and child invitation summary/acceptance flows,
# and for any enabled invitation-mail transport.
# Never place this value in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
